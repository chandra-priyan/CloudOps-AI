# CloudOps AI Environment Configuration

# General Application Settings
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Mode Settings (Mode 1: Core, Mode 2: Full Observability)
OBSERVABILITY_MODE=full

# MongoDB Database Configuration
MONGODB_URI=mongodb://localhost:27017/cloudops_ai

# JWT Security Secrets
JWT_SECRET=super_secret_dev_key_cloudops_ai_2026
JWT_EXPIRES_IN=1d

# FastAPI AI Troubleshooting Service
AI_SERVICE_URL=http://localhost:8000
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder

# Kubernetes Configuration (Optional for local mode)
KUBERNETES_IN_CLUSTER=false
KUBECONFIG_PATH=~/.kube/config

# Prometheus Metrics Scraper
PROMETHEUS_URL=http://localhost:9090

# Remediation Security Policy
ENABLE_DRY_RUN=true
REQUIRE_APPROVAL=true
